# Copier ce fichier en .env puis adapter les valeurs.
# Ce fichier est versionné : il ne doit contenir AUCUN secret réel.

# development, production ou test
NODE_ENV=development

# Port d'écoute du serveur HTTP
PORT=3000

# Origines autorisées à appeler l'API depuis un navigateur (CORS),
# séparées par des virgules. Vide = aucune autre origine que le site lui-même.
CORS_ORIGIN=http://localhost:5173

# Secret de signature des jetons JWT (OBLIGATOIRE). Générez une valeur longue
# et aléatoire, différente sur chaque environnement :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire

# Durée de validité d'un jeton (ex. : 15m, 2h, 1d)
JWT_EXPIRES_IN=2h
