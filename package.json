{
  "name": "edutrack-express",
  "version": "0.1.0",
  "description": "EduTrack - API Express de quiz (jours 3 et 4), construite à partir du code de l'atelier A06.",
  "private": true,
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "node scripts/seed.js --if-missing",
    "start": "node --env-file-if-exists=.env src/index.js",
    "predev": "node scripts/seed.js --if-missing",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "seed": "node scripts/seed.js",
    "demo:sql": "node scripts/sql-demo.js",
    "scenario": "node --env-file-if-exists=.env scripts/scenario.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "typeorm": "^1.1.3"
  }
}
